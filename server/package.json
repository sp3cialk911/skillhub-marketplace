{
  "name": "skillhub-server",
  "version": "1.0.0",
  "description": "SkillHub Marketplace Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development nodemon src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "build": "echo 'No build step needed for Node.js backend'",
    "test": "NODE_ENV=test jest --detectOpenHandles",
    "test:watch": "NODE_ENV=test jest --watch",
    "lint": "eslint src/ --fix",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:reset": "node src/database/reset.js"
  },
  "keywords": ["marketplace", "courses", "skills", "products"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "pg": "^8.11.1",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "stripe": "^13.8.0",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1475.0",
    "axios": "^1.5.0",
    "joi": "^17.11.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.0.0",
    "express-async-errors": "^3.1.1",
    "nodemailer": "^6.9.7",
    "redis": "^4.6.11",
    "uuid": "^9.0.1",
    "moment": "^2.29.4",
    "slug": "^9.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
